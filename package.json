{
  "name": "@senhainfo/fb-connection",
  "version": "2.0.1",
  "repository": "https://github.com/senha-info/senha-fb-connection.git",
  "author": "Bruno Gaspar <dev.brunogaspar@gmail.com>",
  "license": "MIT",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./v1": {
      "types": "./lib/v1/index.d.ts",
      "import": "./lib/v1/index.mjs",
      "require": "./lib/v1/index.js"
    },
    "./v2": {
      "types": "./lib/v2/index.d.ts",
      "import": "./lib/v2/index.mjs",
      "require": "./lib/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "types:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "tsup",
    "prepare": "npm run build",
    "check": "npm run lint && npm run types:check",
    "release": "npm run check && npm version patch && git push origin main --follow-tags"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@senhainfo/shared-utils": "^1.6.8",
    "node-firebird": "^2.18.2",
    "p-limit": "^7.3.0"
  }
}
