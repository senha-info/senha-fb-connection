{
  "name": "@senhainfo/fb-connection",
  "version": "1.7.3",
  "repository": "https://github.com/senha-info/senha-fb-connection.git",
  "author": "Bruno Gaspar <dev.brunogaspar@gmail.com>",
  "license": "MIT",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "types:check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "clean": "rmdir /s /q lib",
    "build": "tsup",
    "prepare": "npm run build",
    "commit:patch": "npm version patch --no-git-tag-version",
    "commit:minor": "npm version minor --no-git-tag-version",
    "commit:major": "npm version major --no-git-tag-version",
    "postversion": "git add package.json && git commit -m v%npm_package_version%"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.14.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "@senhainfo/shared-utils": "^1.5.22",
    "node-firebird": "^2.14.3",
    "p-limit": "^7.3.0"
  }
}
